{
  "theme": "catppuccin-macchiato.json",
  "theme": "catppuccin-latte.json",
  "theme": "catppuccin-mocha.json",
  "theme": "catppuccin-macchiato.json",
  "locale": "en",
  "lsp": {
    "python": {
      "command": "pyright-langserver",
      "args": ["--stdio"],
      "enabled": true,
      "name": "pyright",
      "auto_start": true,
      "process_limits": {
        "max_memory_percent": 50,
        "max_cpu_percent": 90,
        "enabled": true
      }
    },
    "java": {
      "enabled": true,
      "auto_start": true,
      "process_limits": {
        "max_memory_percent": 50,
        "max_cpu_percent": 90,
        "enabled": true
      }
    }
  },
  "plugins": {
    "vi_mode": {
      "enabled": true,
      "settings": {
        "autoStart": false,
        "arrowKeys": true,
        "searchWordUnderCursor": true
      }
    }
  },
  "version": 2,
  "editor": {
    "diagnostics_inline_text": true,
    "screensaver_enabled": true,
    "auto_save_enabled": true,
    "rainbow_indentation": true,
    "relative_line_numbers": true,
    "nerd_font_icons": true,
    "use_terminal_bg": false,
    "show_horizontal_scrollbar": true,
    "completion_popup_auto_show": true,
    "show_prompt_line": true,
    "ensure_final_newline_on_save": true
  }
}